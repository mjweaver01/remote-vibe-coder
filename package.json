{
  "name": "remote-vibe-coder",
  "version": "0.1.0",
  "description": "Run Claude Code remotely from your phone — browse a folder, open a PTY-backed Claude session, and answer prompts from any device on your LAN.",
  "type": "module",
  "bin": {
    "remote-vibe-coder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && tsx watch src/cli.ts",
    "build": "tsx src/build.ts",
    "start": "node dist/cli.js",
    "postinstall": "node scripts/fix-pty-perms.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "remote",
    "terminal",
    "pty",
    "mobile"
  ],
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.59.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
